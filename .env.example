# Neuro-Cut Configuration

# Google Gemini & Google ADK
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ClickHouse Cloud or Local Instance
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=neurocut
CLICKHOUSE_SECURE=false

# MCP Server
MCP_CLICKHOUSE_COMMAND=npx -y @clickhouse/mcp-server

# System
PORT=8000
DEBUG=true
SCORER_MODE=heuristic
OPTIMIZER_MODE=beam_search
SHOWRUNNER_STUCK_THRESHOLD=2
